class Location {
	private nsurl *url;
};

prologue Location()
%{
#include "netsurf/browser_window.h"
%}

init Location(nsurl *url)
%{
	priv->url = url;
	nsurl_ref(url);
%}

fini Location()
%{
	nsurl_unref(priv->url);
%}

method Location::reload()
%{
	JSValue global = QJSB_GLOBAL(ctx);
	JSValue priv_val = JS_GetPropertyStr(ctx, global, "__NSQJS_WIN_PRIV__");
	int64_t _p; JS_ToInt64(ctx, &_p, priv_val);
	window_private_t *priv_win = (window_private_t *)(void*)(uintptr_t)_p;
	JS_FreeValue(ctx, priv_val);
	QJSB_FREE(ctx, global);

	if (priv_win != NULL && priv_win->win != NULL) {
		browser_window_reload(priv_win->win, false);
	} else {
		NSLOG(netsurf, INFO, "failed to get browser context");
	}
	return JS_UNDEFINED;
%}

method Location::assign()
%{
	JSValue global = QJSB_GLOBAL(ctx);
	JSValue priv_val = JS_GetPropertyStr(ctx, global, "__NSQJS_WIN_PRIV__");
	int64_t _p; JS_ToInt64(ctx, &_p, priv_val);
	window_private_t *priv_win = (window_private_t *)(void*)(uintptr_t)_p;
	JS_FreeValue(ctx, priv_val);
	QJSB_FREE(ctx, global);

	if (priv_win == NULL || priv_win->win == NULL) {
		NSLOG(netsurf, INFO, "failed to get browser context");
		return JS_UNDEFINED;
	}

	nsurl *joined;
	size_t slen;
	const char *url = QJSB_TO_CSTRING(ctx, argv[0], &slen);
	if (url == NULL) return JS_UNDEFINED;

	nsurl_join(priv->url, url, &joined);
	JS_FreeCString(ctx, url);
	browser_window_navigate(priv_win->win,
				joined,
				NULL,
				BW_NAVIGATE_HISTORY,
				NULL,
				NULL,
				NULL);
	nsurl_unref(joined);
	return JS_UNDEFINED;
%}

method Location::replace()
%{
	JSValue global = QJSB_GLOBAL(ctx);
	JSValue priv_val = JS_GetPropertyStr(ctx, global, "__NSQJS_WIN_PRIV__");
	int64_t _p; JS_ToInt64(ctx, &_p, priv_val);
	window_private_t *priv_win = (window_private_t *)(void*)(uintptr_t)_p;
	JS_FreeValue(ctx, priv_val);
	QJSB_FREE(ctx, global);

	if (priv_win == NULL || priv_win->win == NULL) {
		NSLOG(netsurf, INFO, "failed to get browser context");
		return JS_UNDEFINED;
	}

	nsurl *joined;
	size_t slen;
	const char *url = QJSB_TO_CSTRING(ctx, argv[0], &slen);
	if (url == NULL) return JS_UNDEFINED;

	nsurl_join(priv->url, url, &joined);
	JS_FreeCString(ctx, url);
	browser_window_navigate(priv_win->win,
				joined,
				NULL,
				BW_NAVIGATE_NONE,
				NULL,
				NULL,
				NULL);
	nsurl_unref(joined);
	return JS_UNDEFINED;
%}

getter Location::href()
%{
	char *url_s = NULL;
	size_t url_l;

	nsurl_get(priv->url, NSURL_COMPLETE, &url_s, &url_l);
	if (url_s == NULL) {
		return JS_UNDEFINED;
	}

	JSValue jsret = QJSB_PUSH_STRING(ctx, url_s, url_l);
	free(url_s);

	return jsret;
%}

setter Location::href()
%{
	JSValue global = QJSB_GLOBAL(ctx);
	JSValue priv_val = JS_GetPropertyStr(ctx, global, "__NSQJS_WIN_PRIV__");
	int64_t _p; JS_ToInt64(ctx, &_p, priv_val);
	window_private_t *priv_win = (window_private_t *)(void*)(uintptr_t)_p;
	JS_FreeValue(ctx, priv_val);
	QJSB_FREE(ctx, global);

	if (priv_win == NULL || priv_win->win == NULL) {
		NSLOG(netsurf, INFO, "failed to get browser context");
		return JS_UNDEFINED;
	}

	nsurl *joined;
	size_t slen;
	const char *url = QJSB_TO_CSTRING(ctx, val, &slen);
	if (url == NULL) return JS_UNDEFINED;

	nsurl_join(priv->url, url, &joined);
	JS_FreeCString(ctx, url);
	browser_window_navigate(priv_win->win,
				joined,
				NULL,
				BW_NAVIGATE_HISTORY,
				NULL,
				NULL,
				NULL);
	nsurl_unref(joined);
	return JS_UNDEFINED;
%}

getter Location::origin()
%{
	char *url_s = NULL;
	size_t url_l;

	nsurl_get(priv->url, NSURL_SCHEME | NSURL_HOST | NSURL_PORT, &url_s, &url_l);

	JSValue jsret = QJSB_PUSH_STRING(ctx, url_s ? url_s : "", url_s ? url_l : 0);

	if (url_s != NULL) {
		free(url_s);
	}

	return jsret;
%}

