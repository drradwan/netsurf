method HTMLTableElement::createTFoot()
%{
	dom_html_element *sec = NULL;
	dom_exception exc = dom_html_table_element_create_t_foot(
		(dom_html_table_element *)((node_private_t *)priv)->node, &sec);
	if (exc != DOM_NO_ERR || sec == NULL) return JS_NULL;
	JSValue ret = qjsw_push_node(ctx, (dom_node *)sec);
	dom_node_unref(sec);
