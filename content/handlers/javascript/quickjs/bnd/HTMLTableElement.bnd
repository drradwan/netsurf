%}

method HTMLTableElement::deleteTFoot()
%{
	dom_html_table_element_delete_t_foot(
		(dom_html_table_element *)((node_private_t *)priv)->node);
	return JS_UNDEFINED;
%}

method HTMLTableElement::insertRow()
%{
	int32_t index = -1;
	if (argc > 0) JS_ToInt32(ctx, &index, argv[0]);
	dom_html_element *row = NULL;
	dom_exception exc = dom_html_table_element_insert_row(
		(dom_html_table_element *)((node_private_t *)priv)->node, index, &row);
	if (exc != DOM_NO_ERR || row == NULL) return JS_NULL;
	JSValue ret = qjsw_push_node(ctx, (dom_node *)row);
	dom_node_unref(row);
	return ret;
%}

method HTMLTableElement::deleteRow()
%{
	int32_t index = 0;
	if (argc > 0) JS_ToInt32(ctx, &index, argv[0]);
	dom_html_table_element_delete_row(
		(dom_html_table_element *)((node_private_t *)priv)->node, index);
	return JS_UNDEFINED;
%}
