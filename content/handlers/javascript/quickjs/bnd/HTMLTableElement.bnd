init HTMLTableElement(struct dom_html_element *html_table_element::html_element);

getter HTMLTableElement::align();
setter HTMLTableElement::align();

getter HTMLTableElement::bgColor();
setter HTMLTableElement::bgColor();

getter HTMLTableElement::border();
setter HTMLTableElement::border();

getter HTMLTableElement::cellPadding();
setter HTMLTableElement::cellPadding();

getter HTMLTableElement::cellSpacing();
setter HTMLTableElement::cellSpacing();

getter HTMLTableElement::frame();
setter HTMLTableElement::frame();

getter HTMLTableElement::rules();
setter HTMLTableElement::rules();

getter HTMLTableElement::summary();
setter HTMLTableElement::summary();

getter HTMLTableElement::width();
setter HTMLTableElement::width();

/* caption, tHead, tFoot, tBodies, rows — native getters removed.
 * The JS polyfill in qjscore.c (A4 block) provides these via DOM
 * child-walk, which handles dynamically-created elements correctly.
 * Native getters from nsgenbind would shadow the polyfill on the
 * same prototype, and the polyfill's delete+defineProperty cannot
 * reliably replace them in QuickJS. */

method HTMLTableElement::createCaption()
%{
	dom_html_element *cap = NULL;
	dom_exception exc = dom_html_table_element_create_caption(
		(dom_html_table_element *)((node_private_t *)priv)->node, &cap);
	if (exc != DOM_NO_ERR || cap == NULL) return JS_NULL;
	JSValue ret = qjsw_push_node(ctx, (dom_node *)cap);
	dom_node_unref(cap);
	return ret;
%}

method HTMLTableElement::deleteCaption()
%{
	dom_html_table_element_delete_caption(
		(dom_html_table_element *)((node_private_t *)priv)->node);
	return JS_UNDEFINED;
%}

method HTMLTableElement::createTHead()
%{
	dom_html_element *sec = NULL;
	dom_exception exc = dom_html_table_element_create_t_head(
		(dom_html_table_element *)((node_private_t *)priv)->node, &sec);
