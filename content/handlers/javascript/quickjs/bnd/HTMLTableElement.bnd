setter HTMLTableElement::width();

getter HTMLTableElement::caption()
%{
	dom_html_table_caption_element *cap = NULL;
	dom_exception exc = dom_html_table_element_get_caption(
		(dom_html_table_element *)((node_private_t *)priv)->node, &cap);
	if (exc != DOM_NO_ERR || cap == NULL) return JS_NULL;
	JSValue ret = qjsw_push_node(ctx, (dom_node *)cap);
	dom_node_unref(cap);
	return ret;
%}

getter HTMLTableElement::tHead()
%{
	dom_html_table_section_element *sec = NULL;
	dom_exception exc = dom_html_table_element_get_t_head(
