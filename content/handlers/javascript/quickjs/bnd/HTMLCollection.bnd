class HTMLCollection {
	private struct dom_html_collection *coll;
};

init HTMLCollection(struct dom_html_collection *coll)
%{
	priv->coll = coll;
	dom_html_collection_ref(coll);
%}

fini HTMLCollection()
%{
	dom_html_collection_unref(priv->coll);
%}

getter HTMLCollection::length()
%{
	dom_exception err;
	uint32_t len;

	err = dom_html_collection_get_length(priv->coll, &len);
	if (err != DOM_NO_ERR) return JS_UNDEFINED;

	return QJSB_PUSH_UINT(ctx, len);
%}

method HTMLCollection::item()
%{
	uint32_t i;
	JS_ToUint32(ctx, &i, argv[0]);
	dom_exception err;
	dom_node *node;

	err = dom_html_collection_item(priv->coll, i, &node);
	if (err != DOM_NO_ERR || node == NULL) return JS_NULL;

	JSValue ret = qjsw_push_node(ctx, node);
	dom_node_unref(node);

	return ret;
%}

method HTMLCollection::namedItem()
%{
	size_t slen;
	const char *s = QJSB_TO_CSTRING(ctx, argv[0], &slen);
	if (s == NULL) return JS_NULL;
	dom_string *name;
	dom_exception err;

	err = dom_string_create((const uint8_t *)s, slen, &name);
	JS_FreeCString(ctx, s);
	if (err != DOM_NO_ERR) return JS_NULL;

	dom_node *node;
	err = dom_html_collection_named_item(priv->coll, name, &node);
	dom_string_unref(name);
	if (err != DOM_NO_ERR || node == NULL) return JS_NULL;

	JSValue ret = qjsw_push_node(ctx, node);
	dom_node_unref(node);

	return ret;
%}
