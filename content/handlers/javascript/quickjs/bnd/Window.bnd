class Window {
	private struct browser_window * win;
	private struct html_content * htmlc;
	private struct window_schedule_s * schedule_ring;
	private bool closed_down;
	prologue %{
#include "utils/corestrings.h"
#include "utils/nsurl.h"
#include "netsurf/browser_window.h"
#include "content/hlcache.h"
#include "html/html.h"
#include "html/private.h"
#include "desktop/gui_internal.h"
#include "netsurf/misc.h"
#include "utils/ring.h"
#include "netsurf/inttypes.h"

#define WINDOW_CALLBACKS "__NSQJS_WindowCallbacks__"

static size_t next_handle = 0;

typedef struct window_schedule_s {
	window_private_t *owner;
	JSContext *ctx;
	struct window_schedule_s *r_next;
	struct window_schedule_s *r_prev;
	size_t handle;
	int repeat_timeout;
	bool running;
	JSValue func;
	JSValue *args;
	int nargs;
} window_schedule_t;

static void window_remove_callback_bits(JSContext *ctx, window_schedule_t *sched) {
	JS_FreeValue(ctx, sched->func);
	for (int i = 0; i < sched->nargs; i++) {
		JS_FreeValue(ctx, sched->args[i]);
	}
	free(sched->args);
	sched->func = JS_UNDEFINED;
	sched->args = NULL;
	sched->nargs = 0;
}

static void
window_call_callback(JSContext *ctx, window_schedule_t *sched, bool clear_entry)
{
	NSLOG(quickjs, DEEPDEBUG, "ctx=%p, handle=%"PRIsizet, ctx, sched->handle);

	JSValue result = qjsw_pcall(ctx, sched->func, JS_UNDEFINED,
				    sched->nargs, sched->args, true);
	JS_FreeValue(ctx, result);

	if (clear_entry) {
		NSLOG(quickjs, DEEPDEBUG, "Not recurring callback, removing");
		window_remove_callback_bits(ctx, sched);
	}
}

static void
window_schedule_callback(void *p)
{
	window_schedule_t *sched = (window_schedule_t *)p;

	NSLOG(quickjs, DEEPDEBUG,
	      "Entered window scheduler callback: %"PRIsizet, sched->handle);

	sched->running = true;
	window_call_callback(sched->ctx, sched,
			     sched->repeat_timeout == 0);
	sched->running = false;

	/* Rebuild box tree + relayout after timer-fired JS */
	if (sched->owner->htmlc != NULL) {
		html_js_reflow(sched->owner->htmlc);
	}

	if (sched->repeat_timeout > 0) {
		NSLOG(quickjs, DEEPDEBUG,
		      "Rescheduling repeating callback %"PRIsizet,
		      sched->handle);
		guit->misc->schedule(sched->repeat_timeout,
				     window_schedule_callback,
				     sched);
	} else {
		NSLOG(quickjs, DEEPDEBUG,
		      "Removing completed callback %"PRIsizet, sched->handle);
		RING_REMOVE(sched->owner->schedule_ring, sched);
		free(sched);
	}
}

static size_t
window_alloc_new_callback(JSContext *ctx,
			  window_private_t *window,
			  bool repeating,
			  int timeout,
			  int argc,
			  JSValueConst *argv)
{
	size_t new_handle = next_handle++;
	window_schedule_t *sched = calloc(1, sizeof *sched);
	if (sched == NULL) {
		return new_handle;
	}
	sched->owner = window;
	sched->ctx = ctx;
	sched->handle = new_handle;
	sched->repeat_timeout = repeating ? timeout : 0;
	sched->running = false;

	/* argv[0] is the callback function, argv[1] is timeout,
	 * argv[2..] are extra arguments to pass to the callback */
	sched->func = JS_DupValue(ctx, argv[0]);
	int extra = (argc > 2) ? argc - 2 : 0;
	sched->nargs = extra;
	if (extra > 0) {
		sched->args = malloc(sizeof(JSValue) * extra);
		for (int i = 0; i < extra; i++) {
			sched->args[i] = JS_DupValue(ctx, argv[2 + i]);
		}
	} else {
		sched->args = NULL;
	}

	RING_INSERT(window->schedule_ring, sched);

	guit->misc->schedule(timeout, window_schedule_callback, sched);
	NSLOG(quickjs, DEEPDEBUG, "Scheduled callback %"PRIsizet" for %d ms from now", new_handle, timeout);

	return new_handle;
}

static void
window_remove_callback_by_handle(JSContext *ctx,
				 window_private_t *window,
				 size_t handle)
{
	int res;

	RING_ITERATE_START(window_schedule_t, window->schedule_ring, sched) {
		if (sched->handle == handle) {
			if (sched->running) {
				NSLOG(quickjs, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			} else {
				NSLOG(quickjs, DEEPDEBUG,
				      "Cancelled callback %"PRIsizet,
				      sched->handle);
				res = guit->misc->schedule(-1,
							   window_schedule_callback,
							   sched);
				assert(res == NSERROR_OK);
				RING_REMOVE(window->schedule_ring, sched);
				window_remove_callback_bits(ctx, sched);
				free(sched);
			}
			RING_ITERATE_STOP(window->schedule_ring, sched);
		}
	} RING_ITERATE_END(window->schedule_ring, sched);
}

static JSValue qjsw_window_closedown_thread(JSContext *ctx,
					     JSValueConst this_val,
					     int argc,
					     JSValueConst *argv)
{
	JSValue global = JS_GetGlobalObject(ctx);
	JSValue priv_val = JS_GetPropertyStr(ctx, global, "__NSQJS_WIN_PRIV__");
	int64_t _p; JS_ToInt64(ctx, &_p, priv_val);
	window_private_t *priv = (window_private_t *)(void*)(uintptr_t)_p;
	JS_FreeValue(ctx, priv_val);
	JS_FreeValue(ctx, global);

	if (priv == NULL) {
		return JS_UNDEFINED;
	}

	priv->closed_down = true;

	NSLOG(quickjs, DEEPDEBUG, "Closing down thread");
	while (priv->schedule_ring != NULL) {
		window_schedule_t *to_remove = NULL;
		RING_ITERATE_START(window_schedule_t, priv->schedule_ring, sched) {
			if (sched->running == false) {
				to_remove = sched;
				RING_ITERATE_STOP(priv->schedule_ring, sched);
			} else if (sched->repeat_timeout != 0) {
				NSLOG(quickjs, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			}
		} RING_ITERATE_END(priv->schedule_ring, sched);

		if (to_remove == NULL) {
			NSLOG(quickjs, DEEPDEBUG,
			      "Leaving in-train callbacks to unwind");
			break;
		}

		window_remove_callback_by_handle(ctx,
						 priv,
						 to_remove->handle);
	}

	return JS_UNDEFINED;
}

%};
};

init Window(struct browser_window *win, struct html_content *htmlc)
%{
	assert(win != NULL);
	assert(htmlc != NULL);
	priv->win = win;
	priv->htmlc = htmlc;
	priv->schedule_ring = NULL;
	priv->closed_down = false;
	NSLOG(netsurf, DEEPDEBUG, "win=%p htmlc=%p", priv->win, priv->htmlc);

	NSLOG(netsurf, DEEPDEBUG,
	      "URL is %s", nsurl_access(browser_window_access_url(priv->win)));
%}

fini Window()
%{
	NSLOG(quickjs, DEEPDEBUG, "Shutting down Window %p", priv->win);
	while (priv->schedule_ring != NULL) {
		window_remove_callback_by_handle(ctx, priv, priv->schedule_ring->handle);
	}
%}

prototype Window()
%{
	/* QuickJS already exposes all standard builtins on the global object,
	 * so no EXPOSE() macro is needed unlike Duktape.
	 * We only need to add the secret closedown thread method. */
	JSValue closedown_fn = JS_NewCFunction(ctx, qjsw_window_closedown_thread,
					       "__NSQJS_closedownThread__", 0);
	JS_SetPropertyStr(ctx, proto, "__NSQJS_closedownThread__", closedown_fn);

	/* Expose Node interface constants (DOM spec §4.5) on global */
	JSValue node_obj = JS_NewObject(ctx);
	JS_SetPropertyStr(ctx, node_obj, "ELEMENT_NODE", JS_NewInt32(ctx, 1));
	JS_SetPropertyStr(ctx, node_obj, "ATTRIBUTE_NODE", JS_NewInt32(ctx, 2));
	JS_SetPropertyStr(ctx, node_obj, "TEXT_NODE", JS_NewInt32(ctx, 3));
	JS_SetPropertyStr(ctx, node_obj, "CDATA_SECTION_NODE", JS_NewInt32(ctx, 4));
	JS_SetPropertyStr(ctx, node_obj, "ENTITY_REFERENCE_NODE", JS_NewInt32(ctx, 5));
	JS_SetPropertyStr(ctx, node_obj, "ENTITY_NODE", JS_NewInt32(ctx, 6));
	JS_SetPropertyStr(ctx, node_obj, "PROCESSING_INSTRUCTION_NODE", JS_NewInt32(ctx, 7));
	JS_SetPropertyStr(ctx, node_obj, "COMMENT_NODE", JS_NewInt32(ctx, 8));
	JS_SetPropertyStr(ctx, node_obj, "DOCUMENT_NODE", JS_NewInt32(ctx, 9));
	JS_SetPropertyStr(ctx, node_obj, "DOCUMENT_TYPE_NODE", JS_NewInt32(ctx, 10));
	JS_SetPropertyStr(ctx, node_obj, "DOCUMENT_FRAGMENT_NODE", JS_NewInt32(ctx, 11));
	JS_SetPropertyStr(ctx, node_obj, "NOTATION_NODE", JS_NewInt32(ctx, 12));
	JS_SetPropertyStr(ctx, proto, "Node", node_obj);

	/* Expose DOMException constructor + error code constants.
	 * Web IDL signature is (message, name), but legacy DOM uses (code).
	 * Support both: if first arg is number, treat as legacy code. */
	const char *domex_src =
		"(function() {"
		"  function DOMException(a, b) {"
		"    if (typeof a === 'number') {"
		"      this.code = a;"
		"      this.name = b || 'Error';"
		"      this.message = b || 'Error';"
		"    } else {"
		"      this.message = a || '';"
		"      this.name = b || 'Error';"
		"      this.code = 0;"
		"    }"
		"  }"
		"  DOMException.prototype = Object.create(Error.prototype);"
		"  DOMException.prototype.constructor = DOMException;"
		"  var codes = {"
		"    INDEX_SIZE_ERR:1, DOMSTRING_SIZE_ERR:2,"
		"    HIERARCHY_REQUEST_ERR:3, WRONG_DOCUMENT_ERR:4,"
		"    INVALID_CHARACTER_ERR:5, NO_DATA_ALLOWED_ERR:6,"
		"    NO_MODIFICATION_ALLOWED_ERR:7, NOT_FOUND_ERR:8,"
		"    NOT_SUPPORTED_ERR:9, INUSE_ATTRIBUTE_ERR:10,"
		"    INVALID_STATE_ERR:11, SYNTAX_ERR:12,"
		"    INVALID_MODIFICATION_ERR:13, NAMESPACE_ERR:14,"
		"    INVALID_ACCESS_ERR:15, VALIDATION_ERR:16,"
		"    TYPE_MISMATCH_ERR:17"
		"  };"
		"  for (var k in codes) {"
		"    DOMException[k] = codes[k];"
		"    DOMException.prototype[k] = codes[k];"
		"  }"
		"  return DOMException;"
		"})()";
	JSValue domex_fn = JS_Eval(ctx, domex_src, strlen(domex_src),
				   "<DOMException>", JS_EVAL_TYPE_GLOBAL);
	if (!JS_IsException(domex_fn)) {
		JS_SetPropertyStr(ctx, proto, "DOMException", domex_fn);
	}

	/* NodeFilter constants for TreeWalker/NodeIterator */
	JSValue nf_obj = JS_NewObject(ctx);
	JS_SetPropertyStr(ctx, nf_obj, "FILTER_ACCEPT", JS_NewInt32(ctx, 1));
	JS_SetPropertyStr(ctx, nf_obj, "FILTER_REJECT", JS_NewInt32(ctx, 2));
	JS_SetPropertyStr(ctx, nf_obj, "FILTER_SKIP", JS_NewInt32(ctx, 3));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_ALL", JS_NewUint32(ctx, 0xFFFFFFFF));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_ELEMENT", JS_NewUint32(ctx, 0x1));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_ATTRIBUTE", JS_NewUint32(ctx, 0x2));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_TEXT", JS_NewUint32(ctx, 0x4));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_CDATA_SECTION", JS_NewUint32(ctx, 0x8));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_ENTITY_REFERENCE", JS_NewUint32(ctx, 0x10));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_ENTITY", JS_NewUint32(ctx, 0x20));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_PROCESSING_INSTRUCTION", JS_NewUint32(ctx, 0x40));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_COMMENT", JS_NewUint32(ctx, 0x100));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_DOCUMENT", JS_NewUint32(ctx, 0x200));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_DOCUMENT_TYPE", JS_NewUint32(ctx, 0x400));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_DOCUMENT_FRAGMENT", JS_NewUint32(ctx, 0x800));
	JS_SetPropertyStr(ctx, nf_obj, "SHOW_NOTATION", JS_NewUint32(ctx, 0x1000));
	JS_SetPropertyStr(ctx, proto, "NodeFilter", nf_obj);

	/* Range — uses polyfill.js Range (no longer duplicated here).
	 * The polyfill.js Range is set on the global object and is used by
	 * __NSQJS_patchDoc_range to patch document.createRange. */

	/* NodeIterator constructor (DOM Traversal §1.2)
	 * Implements pre-removing recovery: when a filter disconnects the
	 * current node (e.g. removeChild inside filter), the iterator
	 * falls back to a saved neighbor computed before the filter ran. */
	static const char ni_src[] =
		"(function(){"
		"var SA=0xFFFFFFFF,FA=1,FR=2,FS=3;"
		"function ntf(t){return 1<<(t-1);}"
		"function ac(it,n){if(!((ntf(n.nodeType)&it._ws)||it._ws===SA))return FS;"
		"if(!it._f)return FA;var r;"
		"if(typeof it._f==='function')r=it._f(n);"
		"else if(typeof it._f.acceptNode==='function')r=it._f.acceptNode(n);"
		"else return FA;return Number(r);}"
		"function nx(n,r){if(n.firstChild)return n.firstChild;"
		"var c=n;while(c&&c!==r){if(c.nextSibling)return c.nextSibling;c=c.parentNode;}return null;}"
		"function pv(n,r){if(n===r)return null;"
		"if(n.previousSibling){var c=n.previousSibling;while(c.lastChild)c=c.lastChild;return c;}"
		"return n.parentNode;}"
		"function cn(n,r){var c=n;while(c){if(c===r)return true;c=c.parentNode;}return false;}"
		"function NI(root,ws,f){this.root=root;this._ws=ws||SA;this._f=f||null;"
		"this.referenceNode=root;this.pointerBeforeReferenceNode=true;this._sp=null;}"
		"NI.prototype.nextNode=function(){var n=this.referenceNode,b=this.pointerBeforeReferenceNode;"
		"while(true){if(!b){var nn=nx(n,this.root);"
		"if(nn===null&&!cn(n,this.root)&&this._sn)nn=this._sn;n=nn;}"
		"b=false;if(n===null)return null;"
		"this._sp=pv(n,this.root);this._sn=nx(n,this.root);"
		"var r=ac(this,n);if(r===FA){"
		"this.referenceNode=n;this.pointerBeforeReferenceNode=false;return n;}"
		"if(!cn(n,this.root)){n=this._sn;if(n===null)return null;b=true;continue;}}};"
		"NI.prototype.previousNode=function(){var n=this.referenceNode,b=this.pointerBeforeReferenceNode;"
		"while(true){if(b){n=pv(n,this.root);"
		"if(n===null&&!cn(this.referenceNode,this.root)&&this._sp)n=this._sp;}"
		"b=true;if(n===null)return null;this._sp=pv(n,this.root);"
		"var r=ac(this,n);if(r===FA){"
		"this.referenceNode=n;this.pointerBeforeReferenceNode=true;return n;}"
		"if(!cn(n,this.root)){n=this._sp;if(n===null)return null;b=false;continue;}}};"
		"NI.prototype.detach=function(){};"
		"return NI;})()";
	JSValue ni_fn = JS_Eval(ctx, ni_src, sizeof(ni_src) - 1,
				"<NodeIterator>", JS_EVAL_TYPE_GLOBAL);
	if (!JS_IsException(ni_fn))
		JS_SetPropertyStr(ctx, proto, "NodeIterator", ni_fn);

	/* TreeWalker constructor (DOM Traversal §1.3) */
	static const char tw_src[] =
		"(function(){"
		"var SA=0xFFFFFFFF,FA=1,FR=2,FS=3;"
		"function ntf(t){return 1<<(t-1);}"
		"function ac(it,n){if(!((ntf(n.nodeType)&it._ws)||it._ws===SA))return FS;"
		"if(!it._f)return FA;var r;"
		"if(typeof it._f==='function')r=it._f(n);"
		"else if(typeof it._f.acceptNode==='function')r=it._f.acceptNode(n);"
		"else return FA;return Number(r);}"
		"function TW(root,ws,f){this.root=root;this._ws=ws||SA;this._f=f||null;this.currentNode=root;}"
		"TW.prototype.parentNode=function(){var n=this.currentNode;"
		"while(n&&n!==this.root){n=n.parentNode;if(!n)return null;"
		"if(ac(this,n)===FA){this.currentNode=n;return n;}}return null;};"
		"TW.prototype.firstChild=function(){return this._tc('first');};"
		"TW.prototype.lastChild=function(){return this._tc('last');};"
		"TW.prototype.nextSibling=function(){return this._ts('next');};"
		"TW.prototype.previousSibling=function(){return this._ts('previous');};"
		"TW.prototype.nextNode=function(){var n=this.currentNode,r=FA;"
		"while(true){while(r!==FR&&n.firstChild!==null){n=n.firstChild;r=ac(this,n);"
		"if(r===FA){this.currentNode=n;return n;}}"
		"var s=null,t=n;while(t&&t!==this.root){s=t.nextSibling;if(s)break;t=t.parentNode;}"
		"if(!s||!t||t===this.root)return null;n=s;r=ac(this,n);"
		"if(r===FA){this.currentNode=n;return n;}}};"
		"TW.prototype.previousNode=function(){var n=this.currentNode;"
		"while(n!==this.root){var s=n.previousSibling;while(s){n=s;var r=ac(this,n);"
		"while(r!==FR&&n.lastChild){n=n.lastChild;r=ac(this,n);}"
		"if(r===FA){this.currentNode=n;return n;}s=n.previousSibling;}"
		"if(n===this.root||!n.parentNode)return null;n=n.parentNode;"
		"if(ac(this,n)===FA){this.currentNode=n;return n;}}return null;};"
		"TW.prototype._tc=function(t){var n=(t==='first')?this.currentNode.firstChild:this.currentNode.lastChild;"
		"while(n){var r=ac(this,n);if(r===FA){this.currentNode=n;return n;}"
		"if(r===FS){var c=(t==='first')?n.firstChild:n.lastChild;if(c){n=c;continue;}}"
		"while(n){var s=(t==='first')?n.nextSibling:n.previousSibling;if(s){n=s;break;}"
		"var p=n.parentNode;if(!p||p===this.root||p===this.currentNode)return null;n=p;}}return null;};"
		"TW.prototype._ts=function(t){var n=this.currentNode;if(n===this.root)return null;"
		"while(true){var s=(t==='next')?n.nextSibling:n.previousSibling;"
		"while(s){n=s;var r=ac(this,n);if(r===FA){this.currentNode=n;return n;}"
		"if(r===FS){s=(t==='next')?n.firstChild:n.lastChild;"
		"if(!s)s=(t==='next')?n.nextSibling:n.previousSibling;}"
		"else s=(t==='next')?n.nextSibling:n.previousSibling;}"
		"n=n.parentNode;if(!n||n===this.root)return null;if(ac(this,n)===FA)return null;}};"
		"return TW;})()";
	JSValue tw_fn = JS_Eval(ctx, tw_src, sizeof(tw_src) - 1,
				"<TreeWalker>", JS_EVAL_TYPE_GLOBAL);
	if (!JS_IsException(tw_fn))
		JS_SetPropertyStr(ctx, proto, "TreeWalker", tw_fn);
%}

getter Window::document()
%{
	NSLOG(netsurf, DEBUG, "priv=%p", priv);
	dom_document *doc = priv->htmlc->document;
	return qjsw_push_node(ctx, (dom_node *)doc);
%}

getter Window::window()
%{
	return JS_DupValue(ctx, this_val);
%}

getter Window::console()
%{
	JSValue cached = JS_GetPropertyStr(ctx, this_val, "__NSQJS_Console__");
	if (!JS_IsUndefined(cached)) {
		return cached;
	}
	JS_FreeValue(ctx, cached);

	JSValue console_obj = qjsw_create_object(ctx, "console", 0, NULL);
	if (JS_IsException(console_obj)) {
		return JS_ThrowTypeError(ctx, "Unable to create console object");
	}
	JS_SetPropertyStr(ctx, this_val, "__NSQJS_Console__",
			  JS_DupValue(ctx, console_obj));
	return console_obj;
%}

getter Window::location()
%{
	JSValue cached = JS_GetPropertyStr(ctx, this_val, "__NSQJS_Location__");
	if (!JS_IsUndefined(cached)) {
		return cached;
	}
	JS_FreeValue(ctx, cached);

	JSValue url_arg = JS_NewInt64(ctx,
		(int64_t)(uintptr_t)llcache_handle_get_url(priv->htmlc->base.llcache));
	JSValue location_obj = qjsw_create_object(ctx, "location", 1, &url_arg);
	JS_FreeValue(ctx, url_arg);
	if (JS_IsException(location_obj)) {
		return JS_ThrowTypeError(ctx, "Unable to create location object");
	}
	JS_SetPropertyStr(ctx, this_val, "__NSQJS_Location__",
			  JS_DupValue(ctx, location_obj));
	return location_obj;
%}

getter Window::navigator()
%{
	JSValue cached = JS_GetPropertyStr(ctx, this_val, "__NSQJS_Navigator__");
	if (!JS_IsUndefined(cached)) {
		return cached;
	}
	JS_FreeValue(ctx, cached);

	JSValue navigator_obj = qjsw_create_object(ctx, "navigator", 0, NULL);
	if (JS_IsException(navigator_obj)) {
		return JS_ThrowTypeError(ctx, "Unable to create navigator object");
	}
	JS_SetPropertyStr(ctx, this_val, "__NSQJS_Navigator__",
			  JS_DupValue(ctx, navigator_obj));
	return navigator_obj;
%}

getter Window::name()
%{
	const char *name;
	browser_window_get_name(priv->win, &name);
	return JS_NewString(ctx, name);
%}

setter Window::name()
%{
	const char *name = JS_ToCString(ctx, val);
	if (name != NULL) {
		browser_window_set_name(priv->win, name);
		JS_FreeCString(ctx, name);
	}
	return JS_UNDEFINED;
%}

method Window::alert()
%{
	if (argc == 0) {
		NSLOG(netsurf, INFO, "JS ALERT");
	} else {
		size_t msg_len;
		const char *msg = JS_ToCStringLen(ctx, &msg_len, argv[0]);
		if (msg != NULL) {
			NSLOG(netsurf, INFO, "JS ALERT: %*s", (int)msg_len, msg);
			JS_FreeCString(ctx, msg);
		}
	}
	return JS_UNDEFINED;
%}

method Window::setTimeout()
%{
	int32_t timeout = 10;

	if (priv->closed_down == true) {
		return JS_UNDEFINED;
	}

	if (argc >= 2) {
		JS_ToInt32(ctx, &timeout, argv[1]);
	}
	if (timeout < 10) { timeout = 10; }
	size_t handle = window_alloc_new_callback(ctx, priv, false,
						  (int)timeout, argc, argv);

	return JS_NewInt32(ctx, (int32_t)handle);
%}

method Window::setInterval()
%{
	int32_t timeout = 10;

	if (priv->closed_down == true) {
		return JS_UNDEFINED;
	}

	if (argc >= 2) {
		JS_ToInt32(ctx, &timeout, argv[1]);
	}
	if (timeout < 10) { timeout = 10; }
	size_t handle = window_alloc_new_callback(ctx, priv, true,
						  (int)timeout, argc, argv);

	return JS_NewInt32(ctx, (int32_t)handle);
%}

method Window::clearTimeout()
%{
	int32_t handle;
	JS_ToInt32(ctx, &handle, argv[0]);
	window_remove_callback_by_handle(ctx, priv, (size_t)handle);

	return JS_UNDEFINED;
%}

method Window::clearInterval()
%{
	int32_t handle;
	JS_ToInt32(ctx, &handle, argv[0]);
	window_remove_callback_by_handle(ctx, priv, (size_t)handle);

	return JS_UNDEFINED;
%}

