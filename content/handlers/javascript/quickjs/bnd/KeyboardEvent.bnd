method KeyboardEvent::getModifierState ()
%{
	dom_string *modifier;
	dom_exception err;
	size_t slen;
	const char *s;
	bool state;

	s = QJSB_TO_CSTRING(ctx, argv[0], &slen);
	err = dom_string_create((const uint8_t *)s, slen, &modifier);
	JS_FreeCString(ctx, s);
	if (err != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}

	err = dom_keyboard_event_get_modifier_state(priv->parent.parent.evt,
			modifier, &state);
	dom_string_unref(modifier);
	if (err != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}

	return QJSB_PUSH_BOOL(ctx, state);
%}
