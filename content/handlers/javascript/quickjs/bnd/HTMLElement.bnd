prologue HTMLElement()
%{
#include <utils/corestrings.h>
%}

init HTMLElement(struct dom_html_element *html_element::element);

method HTMLElement::click()
%{
	dom_exception exc;
	dom_event *evt = NULL;
	bool success;

	/* Get owner document for event creation */
	dom_document *doc = NULL;
	exc = dom_node_get_owner_document(((node_private_t *)priv)->node, &doc);
	if (exc != DOM_NO_ERR || doc == NULL) return JS_UNDEFINED;

	/* Create a MouseEvent via the document's event factory */
	dom_string *mtype;
	exc = dom_string_create((const uint8_t *)"MouseEvent", 10, &mtype);
	if (exc != DOM_NO_ERR) { dom_node_unref(doc); return JS_UNDEFINED; }

	exc = dom_document_event_create_event(
		(dom_document_event *)doc, mtype, &evt);
	dom_string_unref(mtype);
	dom_node_unref(doc);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;

	/* Init as "click", bubbles=true, cancelable=true */
	dom_string *click_str;
	exc = dom_string_create((const uint8_t *)"click", 5, &click_str);
	if (exc != DOM_NO_ERR) { dom_event_unref(evt); return JS_UNDEFINED; }

	exc = dom_mouse_event_init((dom_mouse_event *)evt, click_str,
				   true, true, NULL, 0,
				   0, 0, 0, 0,
				   false, false, false, false, 0, NULL);
	dom_string_unref(click_str);
	if (exc != DOM_NO_ERR) { dom_event_unref(evt); return JS_UNDEFINED; }

	exc = dom_event_target_dispatch_event(
		(dom_event_target *)((node_private_t *)priv)->node,
		evt, &success);
	dom_event_unref(evt);

	return JS_UNDEFINED;
%}

