getter HTMLElement::style()
%{
	/* Minimal implementation to avoid infinite-loop in Modernizr (c.f. #2413) */
	JSValue result = qjsw_create_object(ctx, "cssstyledeclaration", 0, NULL);
	if (JS_IsException(result)) {
		return JS_UNDEFINED;
	}
	return result;
%}
