class NamedNodeMap {
	private struct dom_namednodemap *map;
};

init NamedNodeMap(struct dom_namednodemap *map)
%{
	priv->map = map;
	dom_namednodemap_ref(map);
%}

fini NamedNodeMap()
%{
	dom_namednodemap_unref(priv->map);
%}

getter NamedNodeMap::length()
%{
	dom_exception err;
	uint32_t len;

	err = dom_namednodemap_get_length(priv->map, &len);

	if (err != DOM_NO_ERR) return JS_UNDEFINED;

	return QJSB_PUSH_UINT(ctx, (uint32_t)len);
%}

method NamedNodeMap::item()
%{
	uint32_t i;
	JS_ToUint32(ctx, &i, argv[0]);
	dom_exception err;
	dom_node *node;

	err = dom_namednodemap_item(priv->map, i, &node);

	if (err != DOM_NO_ERR) return JS_UNDEFINED;

	JSValue ret = qjsw_push_node(ctx, node);
	dom_node_unref(node);

	return ret;
%}

method NamedNodeMap::getNamedItem()
%{
	size_t size;
	const char *s = QJSB_TO_CSTRING(ctx, argv[0], &size);
	dom_exception exc;
	dom_node *attr = NULL;
	dom_string *name = NULL;

	exc = dom_string_create((const uint8_t*)s, size, &name);
	JS_FreeCString(ctx, s);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;

	exc = dom_namednodemap_get_named_item(priv->map, name, &attr);
	dom_string_unref(name);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;

	JSValue ret = qjsw_push_node(ctx, attr);
	dom_node_unref(attr);
	return ret;
%}
