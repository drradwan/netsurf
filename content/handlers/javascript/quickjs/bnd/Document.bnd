method Document::createEvent ()
%{
	dom_exception exc;
	dom_event *evt = NULL;
	size_t iface_len = 0;
	const char *iface = NULL;

	if (argc > 0) {
		iface = QJSB_TO_CSTRING(ctx, argv[0], &iface_len);
	}

	/* Map common aliases to libdom's internal event type strings */
	const char *dom_type = "Event";
	if (iface != NULL) {
		if (strcasecmp(iface, "UIEvents") == 0 ||
		    strcasecmp(iface, "UIEvent") == 0)
			dom_type = "UIEvent";
		else if (strcasecmp(iface, "MouseEvents") == 0 ||
			 strcasecmp(iface, "MouseEvent") == 0)
			dom_type = "MouseEvent";
		else if (strcasecmp(iface, "HTMLEvents") == 0)
			dom_type = "Event";
		else if (strcasecmp(iface, "MutationEvents") == 0 ||
			 strcasecmp(iface, "MutationEvent") == 0)
			dom_type = "MutationEvent";
		else if (strcasecmp(iface, "KeyboardEvent") == 0 ||
			 strcasecmp(iface, "KeyboardEvents") == 0)
			dom_type = "KeyboardEvent";
		JS_FreeCString(ctx, iface);
	}

	dom_string *type_str;
	exc = dom_string_create((const uint8_t *)dom_type,
				strlen(dom_type), &type_str);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;

	exc = dom_document_event_create_event(
		(dom_document_event *)priv->parent.node,
		type_str, &evt);
	dom_string_unref(type_str);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;

	exc = dom_event_set_is_trusted(evt, false);
	if (exc != DOM_NO_ERR) { dom_event_unref(evt); return JS_UNDEFINED; }

	/* Pick the right proto name so the JS object gets the correct
	 * prototype (e.g. UIEvent with initUIEvent method) */
	const char *proto_name = "event";
	if (strcmp(dom_type, "UIEvent") == 0)
		proto_name = "ui_event";
	else if (strcmp(dom_type, "MouseEvent") == 0)
		proto_name = "mouse_event";
	else if (strcmp(dom_type, "KeyboardEvent") == 0)
		proto_name = "keyboard_event";
	else if (strcmp(dom_type, "MutationEvent") == 0)
		proto_name = "mutation_event";

	JSValue evt_ptr = JS_NewInt64(ctx, (int64_t)(uintptr_t)evt);
	JSValue jsret = qjsw_create_object(ctx, proto_name, 1, &evt_ptr);
	JS_FreeValue(ctx, evt_ptr);
	if (JS_IsException(jsret)) {
		dom_event_unref(evt);
		JSValue exc_val = JS_GetException(ctx);
		JS_FreeValue(ctx, exc_val);
		return JS_UNDEFINED;
	}

	/* Cache in event map so qjsw_push_event finds this wrapper
	 * when the event is dispatched and bubbles through handlers */
	{
		JSValue global = JS_GetGlobalObject(ctx);
		JSValue emap = JS_GetPropertyStr(ctx, global, "__NSQJS_EVENT_MAP__");
		if (!JS_IsUndefined(emap)) {
			char key[32];
			snprintf(key, sizeof(key), "%p", (void *)evt);
			JS_SetPropertyStr(ctx, emap, key, JS_DupValue(ctx, jsret));
		}
		JS_FreeValue(ctx, emap);
		JS_FreeValue(ctx, global);
	}

	dom_event_unref(evt);
	return jsret;
%}

method Document::createRange()
%{
	/* Call the JS Range() constructor defined in polyfill.js */
	JSValue g = JS_GetGlobalObject(ctx);
	JSValue ctor = JS_GetPropertyStr(ctx, g, "Range");
	JS_FreeValue(ctx, g);
	if (!JS_IsFunction(ctx, ctor)) {
		JS_FreeValue(ctx, ctor);
		return JS_UNDEFINED;
	}
	JSValue range = JS_CallConstructor(ctx, ctor, 0, NULL);
	JS_FreeValue(ctx, ctor);
	if (JS_IsException(range)) return JS_UNDEFINED;
	/* Set start/end to this document */
	JS_SetPropertyStr(ctx, range, "startContainer", JS_DupValue(ctx, this_val));
	JS_SetPropertyStr(ctx, range, "startOffset", JS_NewInt32(ctx, 0));
	JS_SetPropertyStr(ctx, range, "endContainer", JS_DupValue(ctx, this_val));
	JS_SetPropertyStr(ctx, range, "endOffset", JS_NewInt32(ctx, 0));
	JS_SetPropertyStr(ctx, range, "collapsed", JS_TRUE);
	JS_SetPropertyStr(ctx, range, "commonAncestorContainer", JS_DupValue(ctx, this_val));
	return range;
%}

method Document::createNodeIterator()
%{
	/* Call the JS NodeIterator(root, whatToShow, filter) constructor from polyfill.js */
	if (argc < 1) return JS_UNDEFINED;
	JSValue g = JS_GetGlobalObject(ctx);
	JSValue ctor = JS_GetPropertyStr(ctx, g, "NodeIterator");
	JS_FreeValue(ctx, g);
	if (!JS_IsFunction(ctx, ctor)) {
		JS_FreeValue(ctx, ctor);
		return JS_UNDEFINED;
	}
	JSValue args[3];
	args[0] = argv[0];
	args[1] = (argc > 1) ? argv[1] : JS_NewUint32(ctx, 0xFFFFFFFF);
	args[2] = (argc > 2) ? argv[2] : JS_NULL;
	JSValue result = JS_CallConstructor(ctx, ctor, 3, args);
	JS_FreeValue(ctx, ctor);
	if (argc <= 1) JS_FreeValue(ctx, args[1]);
	if (argc <= 2) JS_FreeValue(ctx, args[2]);
	if (JS_IsException(result)) return JS_UNDEFINED;
	return result;
%}

method Document::createTreeWalker()
%{
	/* Call the JS TreeWalker(root, whatToShow, filter) constructor from polyfill.js */
	if (argc < 1) return JS_UNDEFINED;
	JSValue g = JS_GetGlobalObject(ctx);
	JSValue ctor = JS_GetPropertyStr(ctx, g, "TreeWalker");
	JS_FreeValue(ctx, g);
	if (!JS_IsFunction(ctx, ctor)) {
		JS_FreeValue(ctx, ctor);
		return JS_UNDEFINED;
	}
	JSValue args[3];
	args[0] = argv[0];
	args[1] = (argc > 1) ? argv[1] : JS_NewUint32(ctx, 0xFFFFFFFF);
	args[2] = (argc > 2) ? argv[2] : JS_NULL;
	JSValue result = JS_CallConstructor(ctx, ctor, 3, args);
	JS_FreeValue(ctx, ctor);
	if (argc <= 1) JS_FreeValue(ctx, args[1]);
	if (argc <= 2) JS_FreeValue(ctx, args[2]);
	if (JS_IsException(result)) return JS_UNDEFINED;
	return result;
%}

getter Document::implementation ()
%{
	JSValue cached = JS_GetPropertyStr(ctx, this_val, "__NSQJS_DOMImplementation__");
	if (!JS_IsUndefined(cached)) {
		return cached;
	}
	JS_FreeValue(ctx, cached);

	JSValue impl_obj = qjsw_create_object(ctx, "dom_implementation", 0, NULL);
	if (JS_IsException(impl_obj)) {
		return JS_ThrowTypeError(ctx,
			  "Unable to create dom implementation object");
	}
	JS_SetPropertyStr(ctx, this_val, "__NSQJS_DOMImplementation__", JS_DupValue(ctx, impl_obj));
	return impl_obj;
%}

