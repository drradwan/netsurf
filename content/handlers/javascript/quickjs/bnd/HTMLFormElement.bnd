init HTMLFormElement(struct dom_html_element *html_form_element::html_element);

getter HTMLFormElement::acceptCharset();
setter HTMLFormElement::acceptCharset();

getter HTMLFormElement::action();
setter HTMLFormElement::action();

getter HTMLFormElement::enctype();
setter HTMLFormElement::enctype();

getter HTMLFormElement::method();
setter HTMLFormElement::method();

getter HTMLFormElement::target();
setter HTMLFormElement::target();

getter HTMLFormElement::elements()
%{
	dom_html_collection *coll = NULL;
	dom_exception exc = dom_html_form_element_get_elements(
		(dom_html_form_element *)((node_private_t *)priv)->node, &coll);
	if (exc != DOM_NO_ERR || coll == NULL) return JS_UNDEFINED;
	JSValue coll_args[1];
	coll_args[0] = JS_NewInt64(ctx, (int64_t)(uintptr_t)coll);
	JSValue coll_obj = qjsw_create_object(ctx, "html_collection", 1, coll_args);
	JS_FreeValue(ctx, coll_args[0]);
	dom_html_collection_unref(coll);
	if (JS_IsException(coll_obj)) return JS_UNDEFINED;
	JSValue gen_fn = qjsw_push_generics(ctx, "makeListProxy");
	if (!JS_IsFunction(ctx, gen_fn)) {
		JS_FreeValue(ctx, gen_fn);
		return coll_obj;
	}
	JSValue call_args[1] = { coll_obj };
	JSValue result = qjsw_pcall(ctx, gen_fn, JS_UNDEFINED, 1, call_args, false);
	JS_FreeValue(ctx, gen_fn);
	JS_FreeValue(ctx, coll_obj);
	if (JS_IsException(result)) return JS_UNDEFINED;
	return result;
%}

getter HTMLFormElement::length()
%{
	uint32_t len = 0;
	dom_exception exc = dom_html_form_element_get_length(
		(dom_html_form_element *)((node_private_t *)priv)->node, &len);
	if (exc != DOM_NO_ERR) return QJSB_PUSH_UINT(ctx, 0);
	return QJSB_PUSH_UINT(ctx, len);
%}
